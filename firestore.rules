rules_version = '2';

// Expedition Board — Firestore security rules.
// Deployed from the repo: `npx -y firebase-tools@latest deploy --only firestore:rules`
// (this file is the source of truth, not the console editor).
//
// Access model: anyone can sign in with Google, but only accounts whose e-mail appears as a
// document ID in the `allowlist` collection can read or write anything. An allowlist entry
// with `gm: true` marks a GM — the only accounts that can post dated expeditions, schedule a
// proposal, lock or cancel one, or remove someone from a roster.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email; }
    function allowed() {
      return signedIn() && email() != null
        && exists(/databases/$(database)/documents/allowlist/$(email()));
    }
    function isGM() {
      return allowed()
        && get(/databases/$(database)/documents/allowlist/$(email())).data.gm == true;
    }
    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Players may check only their own allowlist entry; only the console (or the CLI) writes here.
    match /allowlist/{e} {
      allow read: if signedIn() && email() == e;
      allow write: if false;
    }

    // Board-wide settings (who the GMs are). Readable by the network, written by GMs.
    match /config/{doc} {
      allow read: if allowed();
      allow write: if isGM();
    }

    // One profile per player. Everyone on the network can read profiles (the overlap grid
    // needs everyone's availability); only the owner can change theirs.
    match /players/{uid} {
      allow read: if allowed();
      allow create, update: if allowed() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Proposals and expeditions.
    //  - Players create proposals (status 'proposed', themselves as proposer).
    //  - Anyone allowed may change `party` and nothing else (seating and withdrawing).
    //  - A proposer may edit or withdraw their own proposal while it is still proposed.
    //  - GMs may do anything, including deleting.
    match /sessions/{id} {
      allow read: if allowed();
      allow create: if isGM()
        || (allowed()
            && request.resource.data.status == 'proposed'
            && request.resource.data.proposerUid == request.auth.uid);
      allow update: if isGM()
        || (allowed() && changesOnly(['party']))
        || (allowed()
            && resource.data.status == 'proposed'
            && resource.data.proposerUid == request.auth.uid
            && request.resource.data.status in ['proposed', 'cancelled']
            && changesOnly(['status', 'title', 'region', 'notes', 'party']));
      allow delete: if isGM();
    }

    // The feed is append-only and every entry is signed by its author. Editing was only ever
    // needed to coalesce availability lines, and those are no longer written at all.
    match /dispatches/{id} {
      allow read: if allowed();
      allow create: if allowed() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
