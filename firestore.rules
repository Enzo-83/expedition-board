rules_version = '2';

// Expedition Board — Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules, then Publish.
//
// Access model: anyone can sign in with Google, but only accounts whose e-mail appears as a
// document ID in the `allowlist` collection can read or write anything. The GM maintains that
// list in the console (Firestore → allowlist → Add document, ID = the player's e-mail).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function allowed() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email));
    }

    // Players may check only their own allowlist entry; only the console writes here.
    match /allowlist/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // One profile per player. Everyone on the network can read profiles (the overlap grid
    // needs everyone's availability); only the owner can change theirs.
    match /players/{uid} {
      allow read: if allowed();
      allow create, update: if allowed() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Expeditions. Anyone allowed can post one and seat/withdraw (party edits are updates);
    // only the poster can delete it.
    match /sessions/{id} {
      allow read: if allowed();
      allow create: if allowed() && request.resource.data.gmUid == request.auth.uid;
      allow update: if allowed();
      allow delete: if allowed() && resource.data.gmUid == request.auth.uid;
    }

    // Every dispatch is signed by its author. Authors may refresh their own entry (used to keep
    // one availability line per editing session); nothing is ever deleted from the feed.
    match /dispatches/{id} {
      allow read: if allowed();
      allow create: if allowed() && request.resource.data.uid == request.auth.uid;
      allow update: if allowed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.kind == resource.data.kind;
      allow delete: if false;
    }
  }
}
